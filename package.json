{
  "name": "metko-magnat",
  "productName": "Метко Магнат",
  "version": "1.1.0",
  "description": "Бърза idle игра: от лимонада до галактическа империя",
  "private": true,
  "scripts": {
    "page": "node page.mjs",
    "sim": "node test/sim.mjs 300",
    "serve": "node test/serve.mjs",
    "icons": "node desktop/icons.mjs",
    "desktop": "npm run page && electron desktop/main.cjs",
    "exe": "npm run page && node desktop/build.mjs",
    "apk": "npm run page && node android/build.mjs",
    "ios": "npm run page && node mobile/prepare.mjs && npx cap sync ios",
    "crazy": "npm run page && node crazygames/build.mjs",
    "covers": "node crazygames/covers.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "electron": "44.4.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
